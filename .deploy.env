# Pi connection
PI_USER=svetlozarstoikov
PI_HOST=raspberrypi.local

# Image
IMAGE_NAME=nau-web
IMAGE_TAG=latest

# Deployment mode: docker compose
# The compose file is copied to REMOTE_DIR; `docker compose up -d` runs there.
# Host port and env live in docker-compose.yml (not PORTS / EXTRA_RUN_ARGS).
# Put STRIPE_SECRET_KEY in $REMOTE_DIR/.env on the Pi — that file
# is not overwritten by deploy.
COMPOSE_FILE=docker-compose.yml
REMOTE_DIR="/home/svetlozarstoikov/apps/nau-web"

# Optional
CONTAINER_NAME=nau-web
