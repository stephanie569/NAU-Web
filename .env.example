# Stripe keys (Dashboard → Developers → API keys)
#
# Local Next.js: copy this file to .env.local
# Pi compose:    copy this file to ~/apps/nau-web/.env on the Pi
#                (deploy does not overwrite that file)
#
# The site serves without STRIPE_SECRET_KEY. /api/checkout needs it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Google Workspace SMTP for the /contact form.
# Use an App Password (Google Account → Security → App passwords), never
# the mailbox login. 2-Step Verification must be on for info@naustudio.org.
# Pi: set SMTP_PASS in ~/apps/nau-web/.env. Do not commit it.
# The site serves without SMTP_PASS; the form returns an error until it is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@naustudio.org
SMTP_PASS=
CONTACT_FROM=info@naustudio.org
CONTACT_TO=info@naustudio.org
