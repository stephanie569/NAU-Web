# Stripe keys (Dashboard → Developers → API keys)
#
# Local Next.js: copy this file to .env.local
# Pi compose:    copy this file to ~/apps/nau-web/.env on the Pi
#                (deploy.sh does not overwrite that file)
#
# The site serves without STRIPE_SECRET_KEY. /api/checkout needs it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
