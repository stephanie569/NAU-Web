# Template only. Next.js and docker compose do not load this file.
# Local: copy to .env.local
# Pi:    copy to ~/apps/nau-web/.env (deploy does not overwrite that file)
#
# Values below are placeholders. Replace them with real keys.

# Optional Cesium ion token for Cesium World Terrain / ion assets
# https://cesium.com/ion/tokens — conservation globe works without it (Esri imagery).
# NEXT_PUBLIC_CESIUM_ION_TOKEN=eyJ...

# Protects POST /api/archive/sync in production (required when NODE_ENV=production)
# ARCHIVE_SYNC_SECRET=long-random-string
# ARCHIVE_LOOKBACK_DAYS=14

# Catalogue of Life via ChecklistBank (https://www.catalogueoflife.org/tools/api)
# 3LXR = Extended Release (~1.65M Animalia species). 3LR = monthly release.
# No API token required for nameusage search / tree endpoints used here.
# COL_DATASET_KEY=3LXR

# --- Wildlife assessments & conservation events ---
# File store: data/wildlife/store.json (no database in this project).
# Editorial UI: /editorial  · Partner submissions: /contribute
#
# IUCN Red List API v4 — DISABLED by default. Public API prohibits commercial use.
# Confirm non-commercial permission for this project's storage + public display
# before enabling. Never put IUCN_TOKEN in NEXT_PUBLIC_* or browser code.
# Docs: https://api.iucnredlist.org/api-docs/index.html
# IUCN_ENABLED=false
# IUCN_TOKEN=
#
# Optional licensed commercial provider (separate adapter — not IUCN endpoints)
# WILDLIFE_LICENSED_PROVIDER_ENABLED=false
#
# Editorial approval secret (Bearer or x-editor-secret) for /editorial APIs
# EDITOR_SECRET=long-random-string
#
# Partner submission secret (optional; without it the form is open but still reviewed)
# PARTNER_SUBMIT_SECRET=long-random-string
#
# Weekly sync (GitHub Action → POST /api/wildlife/sync on the host)
# WILDLIFE_SYNC_SECRET=long-random-string
# Also set GitHub Actions secrets: WILDLIFE_APP_URL, WILDLIFE_SYNC_SECRET
# Host must have IUCN_* only after permission is confirmed.
#
# Optional allowlisted feeds only (JSON array). Imported items stay pending_review.
# Do not invent feeds or scrape arbitrary sites.
# WILDLIFE_FEEDS_JSON=[{"id":"example","name":"Example","url":"https://example.org/feed.xml","type":"rss","defaultSpeciesId":"sp-panthera-leo","defaultRegionId":"region-southern-africa","defaultRegionName":"Southern Africa (broad)","organisation":"Example org"}]


# Stripe (Dashboard → Developers → API keys)
# The site serves without STRIPE_SECRET_KEY. /api/checkout needs it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# Google Workspace SMTP for the /contact form.
# Use an App Password (Google Account → Security → App passwords), never
# the mailbox login. 2-Step Verification must be on for info@naustudio.org.
# The site serves without a real SMTP_PASS; the form returns an error until it is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@naustudio.org
SMTP_PASS=your-app-password-here
CONTACT_FROM=info@naustudio.org
CONTACT_TO=info@naustudio.org

